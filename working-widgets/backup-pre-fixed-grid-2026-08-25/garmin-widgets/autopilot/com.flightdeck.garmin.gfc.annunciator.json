{
  "fdws": "1.3",
  "schemaVersion": "1.3.0",
  "id": "com.flightdeck.garmin.gfc.annunciator",
  "revision": 2,
  "kind": "widget",
  "meta": {
    "name": "Garmin GFC Mode Annunciator",
    "shortName": "AP Modes",
    "author": "Flight Deck Avionics",
    "description": "GFC500/700-style flight director mode annunciator strip. Display-only tiles for master AP/FD/YD/AT and every lateral & vertical mode, lit green the instant that mode engages — read straight off the same live telemetry as the Autopilot page.",
    "category": "Autopilot",
    "tags": ["autopilot", "ap", "fd", "gfc", "annunciator", "modes", "garmin"]
  },
  "layout": {
    "defaultW": 44,
    "defaultH": 14,
    "minW": 28,
    "minH": 10,
    "maxW": 44,
    "maxH": 20,
    "resizable": true,
    "grid": { "columns": 22, "rows": 12 }
  },
  "layerGroups": [
    { "id": "background", "z": 0, "locked": true },
    { "id": "panels", "z": 10 },
    { "id": "indicators", "z": 20 }
  ],
  "state": [],
  "components": [
    {
      "id": "bg_bezel",
      "type": "core.label",
      "layout": { "col": 1, "row": 1, "w": 22, "h": 12 },
      "layer": { "group": "background", "z": 0, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": {
        "background": { "type": "color", "color": "#0c1017" },
        "border": { "width": 1, "color": "#1e293b", "radius": 10 }
      }
    },
    {
      "id": "lbl_title",
      "type": "core.label",
      "layout": { "col": 2, "row": 1, "w": 20, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "FLIGHT DIRECTOR MODE ANNUNCIATION", "align": "center" },
      "style": { "typography": { "font": "Chakra Petch", "size": 11, "weight": 800, "color": "#94a3b8" } }
    },

    { "id": "ind_ap", "type": "core.indicator", "layout": { "col": 2, "row": 3, "w": 5, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apMasterState" },
      "props": { "shape": "tile", "label": "AP", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_fd", "type": "core.indicator", "layout": { "col": 8, "row": 3, "w": 5, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apFdState" },
      "props": { "shape": "tile", "label": "FD", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_yd", "type": "core.indicator", "layout": { "col": 14, "row": 3, "w": 5, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apYdState" },
      "props": { "shape": "tile", "label": "YD", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_at", "type": "core.indicator", "layout": { "col": 20, "row": 3, "w": 1, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apAtState" },
      "props": { "shape": "dot", "label": "", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    {
      "id": "div_1",
      "type": "core.label",
      "layout": { "col": 2, "row": 6, "w": 20, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": { "border": { "width": 1, "color": "#1e293b" } }
    },

    { "id": "lbl_lateral", "type": "core.label", "layout": { "col": 2, "row": 7, "w": 4, "h": 1 }, "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "LATERAL", "align": "left" }, "style": { "typography": { "font": "Chakra Petch", "size": 9, "weight": 700, "color": "#64748b" } } },

    { "id": "ind_hdg", "type": "core.indicator", "layout": { "col": 2, "row": 8, "w": 4, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apHdgModeState" },
      "props": { "shape": "tile", "label": "HDG", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_nav", "type": "core.indicator", "layout": { "col": 7, "row": 8, "w": 4, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apNavModeState" },
      "props": { "shape": "tile", "label": "NAV", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_bc", "type": "core.indicator", "layout": { "col": 12, "row": 8, "w": 4, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apBcModeState" },
      "props": { "shape": "tile", "label": "BC", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_apr", "type": "core.indicator", "layout": { "col": 17, "row": 8, "w": 4, "h": 2 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apAprModeState" },
      "props": { "shape": "tile", "label": "APR", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "lbl_vertical", "type": "core.label", "layout": { "col": 2, "row": 10, "w": 4, "h": 1 }, "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "VERTICAL", "align": "left" }, "style": { "typography": { "font": "Chakra Petch", "size": 9, "weight": 700, "color": "#64748b" } } },

    { "id": "ind_alt", "type": "core.indicator", "layout": { "col": 7, "row": 10, "w": 4, "h": 1 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apAltModeState" },
      "props": { "shape": "dot", "label": "ALT", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_vnv", "type": "core.indicator", "layout": { "col": 12, "row": 10, "w": 4, "h": 1 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apVnavModeState" },
      "props": { "shape": "dot", "label": "VNV", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_vs", "type": "core.indicator", "layout": { "col": 17, "row": 10, "w": 4, "h": 1 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apVsModeState" },
      "props": { "shape": "dot", "label": "VS", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_spd", "type": "core.indicator", "layout": { "col": 7, "row": 11, "w": 4, "h": 1 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apSpdModeState" },
      "props": { "shape": "dot", "label": "SPD", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } },

    { "id": "ind_flc", "type": "core.indicator", "layout": { "col": 12, "row": 11, "w": 4, "h": 1 }, "layer": { "group": "indicators", "z": 20, "pointerEvents": "none" },
      "binding": { "readSimVar": "apFlcModeState" },
      "props": { "shape": "dot", "label": "FLC", "severity": { "bindingRef": "binding", "thresholds": [ { "max": 0, "level": "off" }, { "level": "captured" } ] } } }
  ],
  "capabilities": {
    "readSimVars": [
      "apMasterState", "apFdState", "apYdState", "apAtState",
      "apHdgModeState", "apNavModeState", "apBcModeState", "apAprModeState",
      "apAltModeState", "apVnavModeState", "apVsModeState", "apSpdModeState", "apFlcModeState"
    ],
    "writeEvents": []
  }
}
