{
  "fdws": "1.7",
  "schemaVersion": "1.7.0",
  "id": "com.flightdeck.garmin.attitudeindicator",
  "revision": 13,
  "kind": "widget",
  "meta": {
    "name": "Garmin Attitude Indicator (FD)",
    "shortName": "ADI/FD",
    "author": "Flight Deck Avionics",
    "description": "G1000-style PFD attitude indicator with a full AFCS mode annunciator bar (AP/FD/YD, active + armed lateral and vertical modes, G1000-style non-overlapping layout) and an integrated Flight Director command cue. The sky/ground horizon rotates for bank and translates for pitch as a single rigid body (FDWS v1.5 core.gauge.props.compose), staying locked in sync with the separate bank pointer against the fixed scale. Pitch ladder is 2x scale (5-degree lines) for legibility at small sizes. Slip/skid ball included. Min/default size 14x14.",
    "category": "Avionics",
    "tags": [
      "attitude",
      "adi",
      "pfd",
      "flight director",
      "fd",
      "horizon",
      "garmin",
      "g1000",
      "avionics"
    ]
  },
  "layout": {
    "defaultW": 14,
    "defaultH": 14,
    "minW": 14,
    "minH": 14,
    "maxW": 30,
    "maxH": 30,
    "resizable": true,
    "grid": {
      "columns": 28,
      "rows": 28
    }
  },
  "layerGroups": [
    {
      "id": "background",
      "z": 0,
      "locked": true
    },
    {
      "id": "horizon",
      "z": 10
    },
    {
      "id": "bezel",
      "z": 20
    },
    {
      "id": "pointers",
      "z": 30
    },
    {
      "id": "reference",
      "z": 50
    },
    {
      "id": "annunciator",
      "z": 70
    }
  ],
  "state": [
    {
      "name": "attPitchDeg",
      "type": "number",
      "default": 0,
      "syncFrom": "attPitchDeg",
      "pollFrequencyHz": 100
    },
    {
      "name": "attBankDeg",
      "type": "number",
      "default": 0,
      "syncFrom": "attBankDeg",
      "pollFrequencyHz": 100
    },
    {
      "name": "attSlipSkid",
      "type": "number",
      "default": 0,
      "syncFrom": "attSlipSkid"
    },
    {
      "name": "apFdState",
      "type": "boolean",
      "default": false,
      "syncFrom": "apFdState"
    },
    {
      "name": "attFdPitchCmd",
      "type": "number",
      "default": 0,
      "syncFrom": "attFdPitchCmd",
      "pollFrequencyHz": 100
    },
    {
      "name": "attFdBankCmd",
      "type": "number",
      "default": 0,
      "syncFrom": "attFdBankCmd",
      "pollFrequencyHz": 100
    },
    {
      "name": "apMasterState",
      "type": "number",
      "default": 0,
      "syncFrom": "apMasterState"
    },
    {
      "name": "apYdState",
      "type": "number",
      "default": 0,
      "syncFrom": "apYdState"
    },
    {
      "name": "apHdgModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apHdgModeState"
    },
    {
      "name": "apNavModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apNavModeState"
    },
    {
      "name": "apAprModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apAprModeState"
    },
    {
      "name": "apBcModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apBcModeState"
    },
    {
      "name": "apAltModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apAltModeState"
    },
    {
      "name": "apVsModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apVsModeState"
    },
    {
      "name": "apFlcModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apFlcModeState"
    },
    {
      "name": "apVnavModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apVnavModeState"
    },
    {
      "name": "apAltArmedState",
      "type": "number",
      "default": 0,
      "syncFrom": "apAltArmedState"
    },
    {
      "name": "apGsModeState",
      "type": "number",
      "default": 0,
      "syncFrom": "apGsModeState"
    },
    {
      "name": "apGsArmedState",
      "type": "number",
      "default": 0,
      "syncFrom": "apGsArmedState"
    }
  ],
  "components": [
    {
      "id": "bg_bezel",
      "type": "core.label",
      "layout": {
        "col": 1,
        "row": 1,
        "w": 28,
        "h": 28
      },
      "layer": {
        "group": "background",
        "z": 0,
        "pointerEvents": "none"
      },
      "props": {
        "text": ""
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#05070c"
        },
        "border": {
          "width": 2,
          "color": "#1e293b",
          "radius": 16
        }
      }
    },
    {
      "id": "attitude_sphere",
      "type": "core.gauge",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "horizon",
        "z": 10,
        "clipToBounds": true
      },
      "binding": {
        "readSimVar": "attBankDeg",
        "deadband": 0.1,
        "transition": {
          "durationMs": 100,
          "easing": "linear"
        },
        "pollFrequencyHz": 100
      },
      "props": {
        "transform": "rotate",
        "valueRange": [
          -60,
          60
        ],
        "outputRange": [
          -60,
          60
        ],
        "clamp": true,
        "pivot": {
          "x": "50%",
          "y": "50%"
        },
        "compose": {
          "transform": "translate",
          "axis": "y",
          "stateVar": "attPitchDeg",
          "valueRange": [
            -15,
            15
          ],
          "outputRange": [
            45,
            -45
          ],
          "clamp": true
        }
      },
      "assets": {
        "image": "attitude_sphere"
      },
      "style": {
        "border": {
          "width": 0,
          "color": "transparent",
          "radius": 999
        }
      }
    },
    {
      "id": "fd_pitch_bar",
      "type": "core.gauge",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "horizon",
        "z": 22,
        "clipToBounds": true
      },
      "visibleWhen": {
        "state": "apFdState",
        "equals": 1
      },
      "binding": {
        "readSimVar": "attFdBankCmd",
        "deadband": 0.1,
        "transition": {
          "durationMs": 100,
          "easing": "linear"
        },
        "pollFrequencyHz": 100
      },
      "props": {
        "transform": "rotate",
        "valueRange": [
          -60,
          60
        ],
        "outputRange": [
          60,
          -60
        ],
        "clamp": true,
        "pivot": {
          "x": "50%",
          "y": "50%"
        },
        "compose": {
          "transform": "translate",
          "axis": "y",
          "stateVar": "attFdPitchCmd",
          "relativeToStateVar": "attPitchDeg",
          "valueRange": [
            -15,
            15
          ],
          "outputRange": [
            -45,
            45
          ],
          "clamp": true
        }
      },
      "assets": {
        "image": "fd_pitch_bar"
      },
      "style": {
        "border": {
          "width": 0,
          "color": "transparent",
          "radius": 999
        }
      }
    },
    {
      "id": "bank_scale_ring",
      "type": "core.image",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "bezel",
        "z": 25,
        "pointerEvents": "none"
      },
      "props": {
        "assetId": "bank_scale_ring",
        "fit": "contain"
      }
    },
    {
      "id": "bank_pointer",
      "type": "core.gauge",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "pointers",
        "z": 30
      },
      "binding": {
        "readSimVar": "attBankDeg",
        "deadband": 0.1,
        "transition": {
          "durationMs": 100,
          "easing": "linear"
        },
        "pollFrequencyHz": 100
      },
      "props": {
        "transform": "rotate",
        "valueRange": [
          -60,
          60
        ],
        "outputRange": [
          -60,
          60
        ],
        "clamp": true,
        "pivot": {
          "x": "50%",
          "y": "50%"
        }
      },
      "assets": {
        "image": "bank_pointer"
      }
    },
    {
      "id": "fd_bank_pointer",
      "type": "core.gauge",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "pointers",
        "z": 31
      },
      "visibleWhen": {
        "state": "apFdState",
        "equals": 1
      },
      "binding": {
        "readSimVar": "attFdBankCmd",
        "deadband": 0.1,
        "transition": {
          "durationMs": 100,
          "easing": "linear"
        },
        "pollFrequencyHz": 100
      },
      "props": {
        "transform": "rotate",
        "valueRange": [
          -60,
          60
        ],
        "outputRange": [
          -60,
          60
        ],
        "clamp": true,
        "pivot": {
          "x": "50%",
          "y": "50%"
        }
      },
      "assets": {
        "image": "fd_bank_pointer"
      }
    },
    {
      "id": "slip_goalposts",
      "type": "core.image",
      "layout": {
        "col": 10,
        "row": 9,
        "w": 8,
        "h": 2
      },
      "layer": {
        "group": "bezel",
        "z": 26,
        "pointerEvents": "none"
      },
      "props": {
        "assetId": "slip_goalposts",
        "fit": "contain"
      }
    },
    {
      "id": "slip_ball",
      "type": "core.gauge",
      "layout": {
        "col": 10,
        "row": 9,
        "w": 8,
        "h": 2
      },
      "layer": {
        "group": "pointers",
        "z": 32,
        "clipToBounds": true
      },
      "binding": {
        "readSimVar": "attSlipSkid",
        "deadband": 0.1,
        "transition": {
          "durationMs": 300,
          "easing": "linear"
        }
      },
      "props": {
        "transform": "translate",
        "axis": "x",
        "valueRange": [
          -20,
          20
        ],
        "outputRange": [
          -32,
          32
        ],
        "clamp": true
      },
      "assets": {
        "image": "slip_ball"
      }
    },
    {
      "id": "aircraft_symbol",
      "type": "core.image",
      "layout": {
        "col": 4,
        "row": 6,
        "w": 20,
        "h": 20
      },
      "layer": {
        "group": "reference",
        "z": 50,
        "pointerEvents": "none"
      },
      "props": {
        "assetId": "aircraft_symbol",
        "fit": "contain"
      }
    },
    {
      "id": "div_bar_bottom",
      "type": "core.label",
      "layout": {
        "col": 1,
        "row": 5,
        "w": 28,
        "h": 1
      },
      "layer": {
        "group": "annunciator",
        "z": 65,
        "pointerEvents": "none"
      },
