      },
      "props": {
        "text": ""
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#1e293b"
        }
      }
    },
    {
      "id": "div_vert_col",
      "type": "core.label",
      "layout": {
        "col": 18,
        "row": 1,
        "w": 1,
        "h": 5
      },
      "layer": {
        "group": "annunciator",
        "z": 65,
        "pointerEvents": "none"
      },
      "props": {
        "text": ""
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#1e293b"
        }
      }
    },
    {
      "id": "afcs_ap",
      "type": "core.label",
      "layout": {
        "col": 1,
        "row": 1,
        "w": 7,
        "h": 2
      },
      "layer": {
        "group": "annunciator",
        "z": 70,
        "pointerEvents": "none"
      },
      "visibleWhen": {
        "state": "apMasterState",
        "equals": 1
      },
      "props": {
        "text": "AP",
        "align": "center"
      },
      "style": {
        "typography": {
          "font": "Chakra Petch",
          "size": 12,
          "weight": 800,
          "color": "#22c55e"
        }
      }
    },
    {
      "id": "afcs_fd_only",
      "type": "core.label",
      "layout": {
        "col": 1,
        "row": 1,
        "w": 7,
        "h": 2
      },
      "layer": {
        "group": "annunciator",
        "z": 70,
        "pointerEvents": "none"
      },
      "visibleWhen": {
        "allOf": [
          {
            "state": "apFdState",
            "equals": 1
          },
          {
            "state": "apMasterState",
            "notEquals": 1
