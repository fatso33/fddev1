{
  "fdws": "1.3",
  "schemaVersion": "1.3.0",
  "id": "com.flightdeck.garmin.navradios",
  "revision": 3,
  "kind": "widget",
  "meta": {
    "name": "Garmin NAV Radios",
    "shortName": "NAV1/2",
    "author": "Flight Deck Avionics",
    "description": "GTN-style dual NAV1/NAV2 active/standby frequency panel with swap controls and 4 long-press-configurable quick-tune presets. Long-press a preset to open a GTN-style popup editor (FDWS v1.3 Widget Popover) for its label and frequency.",
    "category": "Avionics",
    "tags": ["radio", "nav", "nav1", "nav2", "avionics", "presets", "frequency", "garmin", "gtn"]
  },
  "layout": {
    "defaultW": 20,
    "defaultH": 12,
    "minW": 12,
    "minH": 8,
    "maxW": 44,
    "maxH": 44,
    "resizable": true,
    "grid": { "columns": 24, "rows": 15 }
  },
  "layerGroups": [
    { "id": "background", "z": 0, "locked": true },
    { "id": "panels", "z": 10 },
    { "id": "controls", "z": 50 }
  ],
  "state": [
    { "name": "nav1ActFreq", "type": "string", "default": "110.30", "syncFrom": "nav1ActFreq" },
    { "name": "nav1StbyFreq", "type": "string", "default": "113.70", "syncFrom": "nav1StbyFreq" },
    { "name": "nav2ActFreq", "type": "string", "default": "108.00", "syncFrom": "nav2ActFreq" },
    { "name": "nav2StbyFreq", "type": "string", "default": "117.20", "syncFrom": "nav2StbyFreq" },
    {
      "name": "presets",
      "type": "array",
      "default": [
        { "freq": "---", "label": "" },
        { "freq": "---", "label": "" },
        { "freq": "---", "label": "" },
        { "freq": "---", "label": "" }
      ]
    }
  ],
  "components": [
    {
      "id": "bg_bezel",
      "type": "core.label",
      "layout": { "col": 1, "row": 1, "w": 24, "h": 15 },
      "layer": { "group": "background", "z": 0, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": {
        "background": { "type": "color", "color": "#0c1017" },
        "border": { "width": 1, "color": "#1e293b", "radius": 10 }
      }
    },
    {
      "id": "lbl_nav1_tag",
      "type": "core.label",
      "layout": { "col": 2, "row": 1, "w": 5, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "NAV 1", "align": "left" },
      "style": { "typography": { "font": "Chakra Petch", "size": 11, "weight": 700, "color": "#94a3b8" } }
    },
    {
      "id": "lbl_title",
      "type": "core.label",
      "layout": { "col": 7, "row": 1, "w": 10, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "NAV RADIOS", "align": "center" },
      "style": { "typography": { "font": "Chakra Petch", "size": 12, "weight": 800, "color": "#cbd5e1" } }
    },
    {
      "id": "box_nav1",
      "type": "core.label",
      "layout": { "col": 2, "row": 2, "w": 22, "h": 4 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": {
        "background": { "type": "color", "color": "#080c14" },
        "border": { "width": 1, "color": "#1e293b", "radius": 8 }
      }
    },
    {
      "id": "lbl_nav1_act",
      "type": "core.label",
      "layout": { "col": 3, "row": 2, "w": 8, "h": 1 },
      "layer": { "group": "controls", "z": 20, "pointerEvents": "none" },
      "props": { "text": "ACTIVE", "align": "center" },
      "style": { "typography": { "font": "Chakra Petch", "size": 10, "weight": 700, "color": "#64748b" } }
    },
    {
      "id": "disp_nav1_act",
      "type": "core.display",
      "layout": { "col": 3, "row": 3, "w": 8, "h": 2 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "readSimVar": "nav1ActFreq", "stateVar": "nav1ActFreq" },
      "props": { "format": "FREQ_NAV" },
      "style": {
        "background": { "type": "none" },
        "border": { "width": 0, "color": "transparent" },
        "typography": { "font": "Chakra Petch", "size": 19, "weight": 800, "color": "#22c55e" }
      }
    },
    {
