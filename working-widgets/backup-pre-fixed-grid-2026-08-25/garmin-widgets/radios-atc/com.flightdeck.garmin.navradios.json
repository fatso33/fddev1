      "props": { "presetSlot": 1, "presetField": "label", "align": "center", "truncate": true },
      "style": { "typography": { "font": "Chakra Petch", "size": 9, "weight": 700, "color": "#64748b" } }
    },
    {
      "id": "lbl_preset_3",
      "type": "core.label",
      "layout": { "col": 14, "row": 12, "w": 5, "h": 1 },
      "layer": { "group": "panels", "z": 20, "pointerEvents": "none" },
      "binding": { "stateVar": "presets" },
      "props": { "presetSlot": 2, "presetField": "label", "align": "center", "truncate": true },
      "style": { "typography": { "font": "Chakra Petch", "size": 9, "weight": 700, "color": "#64748b" } }
