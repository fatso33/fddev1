      "id": "btn_preset_1",
      "type": "core.button",
      "layout": { "col": 2, "row": 13, "w": 5, "h": 2 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "stateVar": "presets" },
      "props": { "variant": "preset", "label": "---", "presetSlot": 0 },
      "style": {
        "background": { "type": "color", "color": "#090d14" },
        "border": { "width": 1, "color": "#1e293b", "radius": 6 },
        "typography": { "font": "Chakra Petch", "size": 14, "weight": 700, "color": "#f8fafc" }
      },
      "interactions": [
        { "trigger": "tap", "action": { "type": "core.applyPresetToField", "field": "nav1StbyFreq", "presetSlot": 0, "event": "nav1StbySet", "openEditorIfEmpty": false } },
        { "trigger": "longpress", "action": {
            "type": "core.openWidgetPopover",
            "popoverWidgetId": "com.flightdeck.garmin.navpreseteditor",
            "context": {
              "currentFreq": { "value": { "stateRef": "presets[0].freq" }, "writable": true, "applyOn": "onHostTap" },
              "currentLabel": { "value": { "stateRef": "presets[0].label" }, "writable": true, "applyOn": "immediate" }
            }
        }, "feedback": { "haptic": "medium" } }
      ]
    },
