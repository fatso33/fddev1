      "layer": { "group": "panels", "z": 20, "pointerEvents": "none" },
      "binding": { "stateVar": "presets" },
      "props": { "presetSlot": 0, "presetField": "label", "align": "center", "truncate": true },
      "style": { "typography": { "font": "Chakra Petch", "size": 9, "weight": 700, "color": "#64748b" } }
    },
    {
      "id": "lbl_preset_2",
      "type": "core.label",
