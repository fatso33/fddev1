{
  "fdws": "1.3",
  "schemaVersion": "1.3.0",
  "id": "com.flightdeck.garmin.transponder",
  "revision": 2,
  "kind": "widget",
  "meta": {
    "name": "Garmin Transponder",
    "shortName": "XPDR",
    "author": "Flight Deck Avionics",
    "description": "GTX-style ATC transponder panel: 4-digit squawk entry, a rotary mode selector (SBY/ON/ALT/GND) matching real GTX330/335 knob detents, a one-tap VFR/1200 preset, and an IDENT annunciator.",
    "category": "Avionics",
    "tags": [
      "transponder",
      "xpdr",
      "atc",
      "squawk",
      "ident",
      "avionics",
      "garmin",
      "gtx"
    ]
  },
  "layout": {
    "defaultW": 24,
    "defaultH": 16,
    "minW": 16,
    "minH": 12,
    "maxW": 30,
    "maxH": 30,
    "resizable": true,
    "grid": {
      "columns": 24,
      "rows": 16
    }
  },
  "layerGroups": [
    {
      "id": "background",
      "z": 0,
      "locked": true
    },
    {
      "id": "panels",
      "z": 10
    },
    {
      "id": "controls",
      "z": 50
    }
  ],
  "state": [
    {
      "name": "xpndrCode",
      "type": "string",
      "default": "1200",
      "syncFrom": "xpndrCode"
    },
    {
      "name": "xpndrMode",
      "type": "string",
      "default": "ALT",
      "syncFrom": "xpndrModeState"
    },
    {
      "name": "identActive",
      "type": "boolean",
      "default": false
    }
  ],
  "components": [
    {
      "id": "bg_bezel",
      "type": "core.label",
      "layout": {
        "col": 1,
        "row": 1,
        "w": 24,
        "h": 16
      },
      "layer": {
        "group": "background",
        "z": 0,
        "pointerEvents": "none"
      },
      "props": {
        "text": ""
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#0c1017"
        },
        "border": {
          "width": 1,
          "color": "#1e293b",
          "radius": 10
        }
      }
    },
    {
      "id": "lbl_title",
      "type": "core.label",
      "layout": {
        "col": 2,
        "row": 1,
        "w": 20,
        "h": 1
      },
      "layer": {
        "group": "panels",
        "z": 10,
        "pointerEvents": "none"
      },
      "props": {
        "text": "TRANSPONDER",
        "align": "center"
      },
      "style": {
        "typography": {
          "font": "Chakra Petch",
          "size": 12,
          "weight": 800,
          "color": "#cbd5e1"
        }
      }
    },
    {
      "id": "box_squawk",
      "type": "core.label",
      "layout": {
        "col": 2,
        "row": 2,
        "w": 12,
        "h": 5
      },
      "layer": {
        "group": "panels",
        "z": 10,
        "pointerEvents": "none"
      },
      "props": {
        "text": ""
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#080c14"
        },
        "border": {
          "width": 1,
          "color": "#1e293b",
          "radius": 8
        }
      }
    },
    {
      "id": "lbl_squawk",
      "type": "core.label",
      "layout": {
        "col": 3,
        "row": 2,
        "w": 10,
        "h": 1
      },
      "layer": {
        "group": "controls",
        "z": 20,
        "pointerEvents": "none"
      },
      "props": {
        "text": "SQUAWK",
        "align": "left"
      },
      "style": {
        "typography": {
          "font": "Chakra Petch",
          "size": 10,
          "weight": 700,
          "color": "#64748b"
        }
      }
    },
    {
      "id": "ind_ident",
      "type": "core.indicator",
      "layout": {
        "col": 10,
        "row": 2,
        "w": 3,
        "h": 1
      },
      "layer": {
        "group": "controls",
        "z": 20,
        "pointerEvents": "none"
      },
      "binding": {
        "stateVar": "identActive"
      },
      "props": {
        "shape": "tile",
        "label": "IDENT",
        "severity": "caution"
      }
    },
    {
      "id": "input_squawk",
      "type": "core.input",
      "layout": {
        "col": 3,
        "row": 3,
        "w": 10,
        "h": 3
      },
      "layer": {
        "group": "controls",
        "z": 50,
        "pointerEvents": "auto"
      },
      "binding": {
        "readSimVar": "xpndrCode",
        "writeEvent": "xpndrSet",
        "stateVar": "xpndrCode"
      },
      "props": {
        "format": "SQUAWK_CODE",
        "min": 0,
        "max": 7777,
        "placeholder": "1200",
        "defaultValue": "1200"
      },
      "style": {
        "background": {
          "type": "none"
        },
        "border": {
          "width": 0,
          "color": "transparent"
        },
        "typography": {
          "font": "Chakra Petch",
          "size": 34,
          "weight": 800,
          "color": "#22c55e"
        }
      }
    },
    {
      "id": "btn_vfr",
      "type": "core.button",
      "layout": {
        "col": 2,
        "row": 8,
        "w": 12,
        "h": 2
      },
      "layer": {
        "group": "controls",
        "z": 50,
        "pointerEvents": "auto"
      },
      "props": {
        "variant": "momentary",
        "label": "VFR / 1200"
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#111827"
        },
        "border": {
          "width": 1,
          "color": "#1f293d",
          "radius": 6
        },
        "typography": {
          "font": "Chakra Petch",
          "size": 13,
          "weight": 700,
          "color": "#f8fafc"
        }
      },
      "interactions": [
        {
          "trigger": "tap",
          "action": {
            "type": "core.setLocalState",
            "field": "xpndrCode",
            "value": "1200"
          }
        },
        {
          "trigger": "tap",
          "action": {
            "type": "core.dispatchEvent",
            "event": "xpndrSet",
            "value": "1200"
          },
          "feedback": {
            "sound": "click_switch_asset",
            "haptic": "light"
          }
        }
      ]
    },
    {
      "id": "btn_ident",
      "type": "core.button",
      "layout": {
        "col": 2,
        "row": 11,
        "w": 12,
        "h": 2
      },
      "layer": {
        "group": "controls",
        "z": 50,
        "pointerEvents": "auto"
      },
      "props": {
        "variant": "toggle",
        "label": "IDENT"
      },
      "binding": {
        "stateVar": "identActive"
      },
      "style": {
        "background": {
          "type": "color",
          "color": "#111827"
        },
        "border": {
          "width": 1,
          "color": "#0891b2",
          "radius": 6
        },
        "typography": {
          "font": "Chakra Petch",
          "size": 13,
          "weight": 800,
          "color": "#22d3ee"
        }
      },
      "interactions": [
        {
          "trigger": "tap",
          "action": {
            "type": "core.toggleLocalState",
            "field": "identActive"
          }
        },
        {
          "trigger": "tap",
          "action": {
            "type": "core.dispatchEvent",
            "event": "xpndrIdent",
            "value": 1
          },
          "feedback": {
            "sound": "click_switch_asset",
            "haptic": "heavy"
          }
        }
      ]
    },
    {
      "id": "lbl_mode",
      "type": "core.label",
      "layout": {
        "col": 15,
        "row": 2,
        "w": 9,
        "h": 1
      },
      "layer": {
        "group": "panels",
        "z": 10,
        "pointerEvents": "none"
      },
      "props": {
        "text": "MODE",
        "align": "center"
      },
      "style": {
        "typography": {
          "font": "Chakra Petch",
          "size": 10,
          "weight": 700,
          "color": "#64748b"
        }
      }
    },
    {
      "id": "mode_selector",
      "type": "core.selector",
      "layout": {
        "col": 15,
        "row": 3,
        "w": 9,
        "h": 10
      },
      "layer": {
        "group": "controls",
        "z": 50,
        "pointerEvents": "auto"
      },
      "props": {
        "mode": "rotary",
        "positions": [
          {
            "value": "GND",
            "label": "GND",
            "angle": 225
          },
          {
            "value": "SBY",
            "label": "SBY",
            "angle": 270
          },
          {
            "value": "ON",
            "label": "ON",
            "angle": 315
          },
          {
            "value": "ALT",
            "label": "ALT",
            "angle": 0
          },
          {
            "value": "TEST",
            "label": "TST",
            "angle": 45
          }
        ]
      },
      "binding": {
        "writeEvent": "xpndrModeSet",
        "stateVar": "xpndrMode"
      },
      "interactions": []
    }
  ],
  "capabilities": {
    "readSimVars": [
      "xpndrCode",
      "xpndrModeState"
    ],
    "writeEvents": [
      "xpndrSet",
      "xpndrModeSet",
      "xpndrIdent"
    ]
  },
  "updatedAt": 1787530340484
}