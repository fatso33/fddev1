{
  "fdws": "1.3",
  "schemaVersion": "1.3.0",
  "id": "com.flightdeck.garmin.navpreseteditor",
  "revision": 1,
  "kind": "popover",
  "meta": {
    "name": "NAV Preset Editor",
    "shortName": "NAV Preset",
    "author": "Flight Deck Avionics",
    "description": "FDWS v1.3 Widget Popover opened by a long-press on a Garmin NAV Radios preset button. Lets you rename the preset and edit its stored NAV frequency without leaving the panel — matching the GTN long-press-to-configure pattern.",
    "category": "Popovers",
    "tags": ["popover", "preset", "editor", "nav", "garmin"]
  },
  "layout": {
    "defaultW": 8,
    "defaultH": 5,
    "grid": { "columns": 12, "rows": 8 }
  },
  "layerGroups": [
    { "id": "background", "z": 0, "locked": true },
    { "id": "panels", "z": 10 },
    { "id": "controls", "z": 50 }
  ],
  "state": [],
  "components": [
    {
      "id": "bg_panel",
      "type": "core.label",
      "layout": { "col": 1, "row": 1, "w": 12, "h": 8 },
      "layer": { "group": "background", "z": 0, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": {
        "background": { "type": "color", "color": "#0c1017" },
        "border": { "width": 1, "color": "#334155", "radius": 10 }
      }
    },
    {
      "id": "lbl_title",
      "type": "core.label",
      "layout": { "col": 1, "row": 1, "w": 12, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "CONFIGURE NAV PRESET", "align": "center" },
      "style": { "typography": { "font": "Chakra Petch", "size": 12, "weight": 800, "color": "#cbd5e1" } }
    },
    {
      "id": "lbl_freq_field",
      "type": "core.label",
      "layout": { "col": 2, "row": 3, "w": 10, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "FREQUENCY", "align": "left" },
      "style": { "typography": { "font": "Chakra Petch", "size": 10, "weight": 700, "color": "#64748b" } }
    },
    {
      "id": "freq_field",
      "type": "core.input",
      "layout": { "col": 2, "row": 4, "w": 10, "h": 2 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "stateVar": "$context.currentFreq.value" },
      "props": { "format": "FREQ_NAV", "min": 108.0, "max": 117.95, "placeholder": "113.70" },
      "style": {
        "background": { "type": "color", "color": "#06090f" },
        "border": { "width": 1, "color": "#1e293b", "radius": 6 },
        "typography": { "font": "Chakra Petch", "size": 18, "weight": 700, "color": "#f8fafc" }
      },
      "interactions": [
        { "trigger": "change", "action": { "type": "core.commitToHost", "contextKey": "currentFreq" } }
      ]
    },
    {
      "id": "lbl_label_field",
      "type": "core.label",
      "layout": { "col": 2, "row": 6, "w": 10, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "LABEL", "align": "left" },
      "style": { "typography": { "font": "Chakra Petch", "size": 10, "weight": 700, "color": "#64748b" } }
    },
    {
      "id": "label_field",
      "type": "core.input",
      "layout": { "col": 2, "row": 7, "w": 6, "h": 2 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "stateVar": "$context.currentLabel.value" },
      "props": { "format": "RAW_TEXT", "placeholder": "e.g. KJFK" },
      "style": {
        "background": { "type": "color", "color": "#06090f" },
        "border": { "width": 1, "color": "#1e293b", "radius": 6 },
        "typography": { "font": "Chakra Petch", "size": 16, "weight": 700, "color": "#f8fafc" }
      },
      "interactions": [
        { "trigger": "change", "action": { "type": "core.commitToHost", "contextKey": "currentLabel" } }
      ]
    },
    {
      "id": "save_btn",
      "type": "core.button",
      "layout": { "col": 9, "row": 7, "w": 3, "h": 2 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "props": { "variant": "momentary", "label": "DONE" },
      "style": {
        "background": { "type": "color", "color": "#111827" },
        "border": { "width": 1, "color": "#22c55e", "radius": 6 },
        "typography": { "font": "Chakra Petch", "size": 13, "weight": 800, "color": "#22c55e" }
      },
      "interactions": [
        { "trigger": "tap", "action": { "type": "core.closePopover" }, "feedback": { "haptic": "light" } }
      ]
    }
  ]
}
