{
  "fdws": "1.3",
  "schemaVersion": "1.3.0",
  "id": "com.flightdeck.garmin.lighting.interior",
  "revision": 2,
  "kind": "widget",
  "meta": {
    "name": "Garmin Panel & Cabin Lighting",
    "shortName": "INT LTS",
    "author": "Flight Deck Avionics",
    "description": "Cockpit backlighting control with a spring-loaded panel-brightness rocker (FDWS v1.2 core.rocker) instead of a plain toggle, plus cabin light and panel flood switches with their own status LEDs.",
    "category": "Lighting",
    "tags": ["lights", "interior", "panel", "cabin", "dimmer", "backlight", "garmin"]
  },
  "layout": {
    "defaultW": 30,
    "defaultH": 20,
    "minW": 24,
    "minH": 16,
    "maxW": 30,
    "maxH": 20,
    "resizable": true,
    "grid": { "columns": 16, "rows": 16 }
  },
  "layerGroups": [
    { "id": "background", "z": 0, "locked": true },
    { "id": "panels", "z": 10 },
    { "id": "controls", "z": 50 }
  ],
  "state": [
    { "name": "panel", "type": "boolean", "default": true, "syncFrom": "panelFloodState" },
    { "name": "cabin", "type": "boolean", "default": true, "syncFrom": "cabinLightState" },
    { "name": "panelBrightness", "type": "number", "default": 50, "syncFrom": "panelBrightnessLevel" }
  ],
  "components": [
    {
      "id": "bg_bezel",
      "type": "core.label",
      "layout": { "col": 1, "row": 1, "w": 16, "h": 16 },
      "layer": { "group": "background", "z": 0, "pointerEvents": "none" },
      "props": { "text": "" },
      "style": { "background": { "type": "color", "color": "#0c1017" }, "border": { "width": 1, "color": "#1e293b", "radius": 10 } }
    },
    {
      "id": "lbl_title",
      "type": "core.label",
      "layout": { "col": 2, "row": 1, "w": 14, "h": 1 },
      "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "PANEL & CABIN LIGHTING", "align": "center" },
      "style": { "typography": { "font": "Chakra Petch", "size": 12, "weight": 800, "color": "#cbd5e1" } }
    },

    { "id": "btn_panel", "type": "core.button", "layout": { "col": 2, "row": 3, "w": 14, "h": 3 }, "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "readSimVar": "panelFloodState", "stateVar": "panel" },
      "props": { "variant": "toggle", "label": "PANEL FLOOD", "hasLed": true },
      "style": { "background": { "type": "color", "color": "#111827" }, "border": { "width": 1, "color": "#1f293d", "radius": 8 }, "typography": { "font": "Chakra Petch", "size": 12, "weight": 700, "color": "#f8fafc" } },
      "interactions": [
        { "trigger": "tap", "action": { "type": "core.toggleLocalState", "field": "panel" } },
        { "trigger": "tap", "action": { "type": "core.dispatchEvent", "event": "panelLightsToggle", "value": 0 }, "feedback": { "sound": "click_switch_asset", "haptic": "light" } }
      ] },

    { "id": "lbl_dimmer", "type": "core.label", "layout": { "col": 2, "row": 7, "w": 14, "h": 1 }, "layer": { "group": "panels", "z": 10, "pointerEvents": "none" },
      "props": { "text": "PANEL BRIGHTNESS", "align": "left" }, "style": { "typography": { "font": "Chakra Petch", "size": 10, "weight": 700, "color": "#64748b" } } },

    { "id": "disp_brightness", "type": "core.display", "layout": { "col": 12, "row": 7, "w": 4, "h": 1 }, "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "readSimVar": "panelBrightnessLevel", "stateVar": "panelBrightness" }, "props": { "format": "PERCENT" },
      "style": { "background": { "type": "none" }, "border": { "width": 0, "color": "transparent" }, "typography": { "font": "Chakra Petch", "size": 12, "weight": 800, "color": "#22c55e" } } },

    {
      "id": "rocker_dimmer",
      "type": "core.rocker",
      "layout": { "col": 2, "row": 8, "w": 14, "h": 4 },
      "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "props": {
        "axis": "x",
        "zones": [
          { "id": "dim_down", "label": "◀ DIM", "writeEvent": "panelLightsDec", "repeatRate": 120 },
          { "id": "dim_up",   "label": "BRT ▶", "writeEvent": "panelLightsInc", "repeatRate": 120 }
        ],
        "springReturn": true
      },
      "interactions": []
    },

    { "id": "btn_cabin", "type": "core.button", "layout": { "col": 2, "row": 13, "w": 14, "h": 3 }, "layer": { "group": "controls", "z": 50, "pointerEvents": "auto" },
      "binding": { "readSimVar": "cabinLightState", "stateVar": "cabin" },
      "props": { "variant": "toggle", "label": "CABIN", "hasLed": true },
      "style": { "background": { "type": "color", "color": "#111827" }, "border": { "width": 1, "color": "#1f293d", "radius": 8 }, "typography": { "font": "Chakra Petch", "size": 12, "weight": 700, "color": "#f8fafc" } },
      "interactions": [
        { "trigger": "tap", "action": { "type": "core.toggleLocalState", "field": "cabin" } },
        { "trigger": "tap", "action": { "type": "core.dispatchEvent", "event": "cabinLightsToggle", "value": 0 }, "feedback": { "sound": "click_switch_asset", "haptic": "light" } }
      ] }
  ],
  "capabilities": {
    "readSimVars": ["panelFloodState", "cabinLightState", "panelBrightnessLevel"],
    "writeEvents": ["panelLightsToggle", "panelLightsInc", "panelLightsDec", "cabinLightsToggle"]
  }
}
